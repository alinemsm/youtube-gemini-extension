{
    "manifest_version": 3,
    "name": "YouTube to Gemini Analyzer",
    "version": "1.0",
    "description": "Send YouTube videos to Gemini for analysis",
    "permissions": [
      "activeTab",
      "storage"
    ],
    "host_permissions": [
      "https://generativelanguage.googleapis.com/*"
    ],
    "action": {
      "default_popup": "popup.html",
      "default_icon": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
      }
    },
    "background": {
      "service_worker": "background.js"
    }
  }